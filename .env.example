# Copier en .env.local (jamais commité) et remplir. En ligne : variables d'environnement de l'hébergeur.
#
# Firebase = backend de production (connexion par code SMS ou email, Firestore, Storage).
# Console Firebase > Paramètres du projet > Vos applications.
# Laisser NEXT_PUBLIC_FIREBASE_API_KEY vide = mode MAQUETTE (tout reste dans le navigateur).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=mossala-6f297.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=mossala-6f297
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Région des Cloud Functions (code email). Par défaut : europe-west1.
NEXT_PUBLIC_FIREBASE_FUNCTIONS_REGION=europe-west1

# Les secrets SMTP (code email) et Africa's Talking (alertes) ne vont PAS ici :
# ils sont gardés par Firebase (voir firebase-functions/README.md).
