rules_version = '2';

// Règles de sécurité Firestore — ArtisanBrazza (projet mossala-6f297)
// Déploiement : firebase deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {

    function connecte() {
      return request.auth != null;
    }
    function proprietaire(uid) {
      return connecte() && request.auth.uid == uid;
    }
    // Numéro vérifié par le code SMS (Firebase Authentication)
    function telVerifie() {
      return request.auth.token.phone_number;
    }
    // Le numéro n'est exposé publiquement que si l'artisan l'a choisi
    function numeroCoherent(d) {
      return d.numeroPublic is bool
        && (d.numeroPublic ? d.telephonePublic == telVerifie() : d.telephonePublic == null);
    }

    // ——— Profils professionnels (artisans et boutiques) ———
    match /pros/{uid} {
      allow read: if true;

      allow create: if proprietaire(uid)
        && request.resource.data.type in ['artisan', 'boutique']
        && request.resource.data.statut == 'en_verification'   // la vérification est faite par l'équipe
        && request.resource.data.nom is string
        && request.resource.data.nom.size() >= 2
        && request.resource.data.nom.size() <= 80
        && numeroCoherent(request.resource.data);

      allow update: if proprietaire(uid)
        && request.resource.data.statut == resource.data.statut // seul l'admin change le statut
        && request.resource.data.type == resource.data.type
        && numeroCoherent(request.resource.data);

      allow delete: if false;

      // Coordonnées privées : lisibles par le propriétaire seul
      match /prive/{docId} {
        allow read: if proprietaire(uid);
        allow create, update: if proprietaire(uid)
          && docId == 'contact'
          && request.resource.data.telephone == telVerifie();
        allow delete: if false;
      }
    }

    // Tout le reste est fermé par défaut
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
